{
  "_source": "Generated by scripts/gen_webhook_vectors.mjs using Node crypto, mirroring DevinoSolutions/shorty-sdk test/webhooks.test.ts scenario-for-scenario. Signatures are produced by the TypeScript/Node implementation, so a Python pass proves cross-implementation agreement, not self-consistency.",
  "signed_content": "<webhook-id>.<webhook-timestamp>.<raw-body>, HMAC-SHA256 with base64-decoded secret bytes, header token \"v1,<base64>\"",
  "cases": [
    {
      "name": "valid single signature verifies",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"event\":\"job.succeeded\",\"data\":{\"id\":\"j1\"}}",
      "timestamp": 1753000000,
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYSEh",
      "signature_header": "v1,xgyqwn3AzHnl3ddh/bGUQDd0KPinHWmZa6kEoRvXYDQ=",
      "expected_valid": true
    },
    {
      "name": "rotation: two signatures, receiver still on the old secret",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"a\":1}",
      "timestamp": 1753000000,
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYSEh",
      "signature_header": "v1,zv6BsWDWJqhGkXhcAeCew5ANZTi6RYHW6kDCxaDPfeg= v1,ga1aiS88AkjeSWlXyTKOiTZgu67riO/TuKXtB2JIH1s=",
      "expected_valid": true
    },
    {
      "name": "unknown version tokens (v2,) are ignored, not rejected",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"a\":1}",
      "timestamp": 1753000000,
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYSEh",
      "signature_header": "v2,deadbeef v1,ga1aiS88AkjeSWlXyTKOiTZgu67riO/TuKXtB2JIH1s=",
      "expected_valid": true
    },
    {
      "name": "tampered body fails",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"amount\":999}",
      "timestamp": 1753000000,
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYSEh",
      "signature_header": "v1,mIKxb9REWmjDp4FTE/y+mWPIkYHsQEGUhUyB1t3Llkw=",
      "expected_valid": false,
      "expected_reason": "no_matching_signature"
    },
    {
      "name": "reserialized JSON body fails (the raw-byte rule)",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"a\":1,\"b\":2}",
      "timestamp": 1753000000,
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYSEh",
      "signature_header": "v1,ZwFYPweYmKdhg1BCspd91O9m5Is4269n87ePZdBfqMo=",
      "expected_valid": false,
      "expected_reason": "no_matching_signature"
    },
    {
      "name": "stale timestamp (older than tolerance) fails",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"a\":1}",
      "timestamp": 1752996400,
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYSEh",
      "signature_header": "v1,avJoRNbMTd6kawxFzSLc/2baWYI0bTxELtlfIXfF3ds=",
      "tolerance_seconds": 300,
      "expected_valid": false,
      "expected_reason": "timestamp_out_of_tolerance"
    },
    {
      "name": "future skew within tolerance passes",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"a\":1}",
      "timestamp": 1753000120,
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYSEh",
      "signature_header": "v1,JUIO0MQ5Z8HeQMKny0fsOAGNGcVuj/4+E69+PCLgw6Q=",
      "expected_valid": true
    },
    {
      "name": "malformed timestamp header fails",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"a\":1}",
      "timestamp": "not-a-number",
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYSEh",
      "signature_header": "v1,ga1aiS88AkjeSWlXyTKOiTZgu67riO/TuKXtB2JIH1s=",
      "expected_valid": false,
      "expected_reason": "malformed_timestamp"
    },
    {
      "name": "wrong secret fails to match",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"a\":1}",
      "timestamp": 1753000000,
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYiEh",
      "signature_header": "v1,ga1aiS88AkjeSWlXyTKOiTZgu67riO/TuKXtB2JIH1s=",
      "expected_valid": false,
      "expected_reason": "no_matching_signature"
    },
    {
      "name": "utf-8 body verifies (raw bytes, not code points)",
      "webhook_id": "msg_123",
      "now_seconds": 1753000000,
      "payload": "{\"unicode\":\"café — naïve\"}",
      "timestamp": 1753000000,
      "secret": "whsec_c2hvcnR5LXB5dGhvbi12ZWN0b3ItYSEh",
      "signature_header": "v1,QUAjZ4PlTfebpQ+AwGaBiywI1AlbPg/DFPk+je60RnY=",
      "expected_valid": true
    }
  ]
}
